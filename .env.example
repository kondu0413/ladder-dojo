# =============================================================================
# .env.example — 必要な環境変数の一覧(値は空)
#
# 使い方: cp .env.example .env.local  して値を埋める。.env.local は git 管理外。
# 取得手順は docs/SETUP.md。
#
# 重要:
#   - Claude Code の開発・テスト(ユニット / API / E2E)は環境変数なしで動く。
#     ローカル D1 と E2E 専用ログイン(wrangler.jsonc の env.e2e)で完結するため。
#   - このファイルの値が必要になるのは「人間が手元で Google ログインを試すとき」と
#     「手元から手動デプロイするとき」だけ。CI/本番は GitHub Secrets → Worker のシークレットに流れる。
#   - ブラウザに埋め込まれる変数(VITE_*)は存在しない。秘密の値に VITE_ を付けないこと。
#   - wrangler dev はこのファイルを読む(pnpm dev が --env-file で渡す)。
#     apps/api/.dev.vars は使わない(二重管理を避ける)。
# =============================================================================

# ---------------------------------------------------------------------------
# Better Auth(セッション Cookie の署名鍵)— 手元で認証を試すとき
# 生成: openssl rand -base64 32
# 本番の値は GitHub Secrets の BETTER_AUTH_SECRET(CI が Worker に設定)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Google ログイン(OAuth クライアント)— 手元で認証を試すとき
# 取得: Google Cloud → API とサービス → 認証情報 → ladder-dojo-web(docs/SETUP.md §2.2)
# 手元で使うには、リダイレクト URI に http://localhost:5173/api/auth/callback/google が登録されていること
# 本番の値は GitHub Secrets の GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET(CI が Worker に設定)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare — 手元から wrangler で手動デプロイ / D1 を操作する場合のみ
# 通常は GitHub Secrets にだけ置く(docs/SETUP.md §3.1)。アカウント ID は wrangler が
# トークンから自動解決する(CI は wrangler whoami で取得する。D-012)
# 取得: API Token → Cloudflare Dashboard → My Profile → API Tokens
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# E2E テスト(Playwright)— 任意
# 未設定なら Playwright が wrangler dev(ビルド済み SPA + ローカル D1)を自動起動して使う
# ---------------------------------------------------------------------------
E2E_BASE_URL=

# ---------------------------------------------------------------------------
# ここに書かないもの(リポジトリにコミットする wrangler.jsonc に置く、秘密でない値)
#   - Worker 名(ladder-dojo)、workers.dev サブドメイン(mojya)、BETTER_AUTH_URL(本番 URL)
#   - D1 の database_id(CI が実行時に wrangler d1 list の値で上書きする)
#   - E2E_AUTH_BYPASS(env.e2e にのみ存在。本番には無い)
# ---------------------------------------------------------------------------
