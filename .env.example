# =============================================================================
# .env.example — 必要な環境変数の一覧(値は空)
#
# 使い方: cp .env.example .env.local  して値を埋める。.env.local は git 管理外。
# 取得手順は docs/SETUP.md、各キーの「いつから必要か」は下記の [時点] を参照。
#   [A] ローカル開発時点   … シミュレータ・公式問題・サンドボックスはサーバー不要のため、環境変数なしで動く
#   [B] 認証実装時点       … ログイン・進捗保存・回路保存を実装するとき
#   [C] デプロイ時点       … Cloudflare Pages へ公開するとき(主に GitHub Actions Secrets に置く)
#   [D] フェーズ2          … Cloudflare Pages Functions(サーバー側再検証)を使い始めるとき
#
# VITE_ で始まる変数だけがブラウザに埋め込まれる。秘密の値に VITE_ を付けないこと。
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase(認証・DB)— ブラウザ側 [B]
# 取得: Supabase Dashboard → Project Settings → API
# ローカルでは dev プロジェクト(ladder-dojo-dev)の値を入れる
# ---------------------------------------------------------------------------
# Project URL(例: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=
# Publishable key(sb_publishable_...)。旧UIでは anon / public と表示される JWT
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase CLI(マイグレーション・型生成)— ローカルで CLI を使う場合のみ [B]
# CI では GitHub Secrets の SUPABASE_DEV_* / SUPABASE_PROD_* から注入される
# ---------------------------------------------------------------------------
# Project ref(ダッシュボード URL の /project/ 直後の英数字。Project Settings → General → Reference ID)
SUPABASE_PROJECT_REF=
# プロジェクト作成時に生成した DB パスワード
SUPABASE_DB_PASSWORD=
# 個人アクセストークン(https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Supabase 管理用鍵 — サーバー側専用。ブラウザ・リポジトリに絶対に入れない
#   [B] E2E テストのテストユーザー作成スクリプトで使用(ローカル実行時のみここに書く)
#   [D] Cloudflare Pages Functions の Variables and Secrets に設定
# 取得: Supabase Dashboard → Project Settings → API → Secret key(旧 service_role)
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=
# Pages Functions 用の URL(VITE_ なし。値は VITE_SUPABASE_URL と同じ)[D]
SUPABASE_URL=

# ---------------------------------------------------------------------------
# Cloudflare(ホスティング)— [C] GitHub Actions Secrets に置く。ローカルから wrangler で手動デプロイする場合のみここに書く
# 取得: API Token → Cloudflare Dashboard → My Profile → API Tokens
#       Account ID → Workers & Pages 概要ページ右側
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# E2E テスト(Playwright)— [B] 任意
# 未設定なら Playwright がローカルの Vite dev server を起動して使う
# ---------------------------------------------------------------------------
E2E_BASE_URL=

# ---------------------------------------------------------------------------
# 環境変数に入れないもの(各サービスのダッシュボードに直接設定する)
#   - Google OAuth の Client ID / Client Secret → Supabase → Authentication → Providers → Google
#   - Brevo の SMTP キー                        → Supabase → Authentication → SMTP Settings
# ---------------------------------------------------------------------------
